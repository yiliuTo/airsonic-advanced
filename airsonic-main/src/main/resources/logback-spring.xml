<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Include Spring Boot's default Logback configuration support -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Define the CONSOLE appender -->
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    
    <!-- Configure the root logger -->
    <!-- The level is sourced from 'logging.level.root' in application.properties, defaulting to WARN if not set -->
    <root level="${logging.level.root:-WARN}">
        <appender-ref ref="CONSOLE" /> <!-- Reference the CONSOLE appender to output logs to the console -->
    </root>

    <!-- Configure specific loggers -->
    <!-- Levels are sourced from application.properties (e.g., logging.level.org.airsonic), defaulting if not set -->
    <logger name="org.airsonic" level="${logging.level.org.airsonic:-INFO}"/>
    <logger name="liquibase" level="${logging.level.liquibase:-INFO}"/>

    <!-- Add other specific logger configurations here if needed, e.g.: -->
    <!-- <logger name="org.springframework.web" level="WARN"/> -->
    <!-- <logger name="org.hibernate" level="WARN"/> -->

</configuration>
